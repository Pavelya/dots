<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The light, medium and strong vibrations of play (motion.md, rule 6). Granted without asking. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        No IDs for ads (decision 0033; C-03 keeps it so for AdMob): AdMob and Firebase add the
        advertising ID permission and Android's ad services (Privacy Sandbox: its ad ID, attribution
        and topics); the game removes them all. Ads still show, chosen without them.
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_TOPICS"
        tools:node="remove" />

    <!-- The Shop sells only where Google Play's store app is on the phone (DotsApplication.store). -->
    <!-- Rewarded ads only where Google Play services are on the phone (DotsApplication.ads). -->
    <queries>
        <package android:name="com.android.vending" />
        <package android:name="com.google.android.gms" />
    </queries>

    <application
        android:name=".DotsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dots"
        tools:targetApi="31">
        <!-- The game's app in AdMob, for the rewarded ads (C-03); set in build.gradle.kts. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the share sheet read the game log, and only when the player shares it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
    </application>

</manifest>
