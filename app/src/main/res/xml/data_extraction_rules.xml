<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Backup and device transfer take only the campaign progress: stars, the
     player's own boosters, chests opened and cosmetics owned (ProgressRepository). Settings, saved
     games and the test log stay on the phone: an <include> leaves out everything it does not name. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/progress.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/progress.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
