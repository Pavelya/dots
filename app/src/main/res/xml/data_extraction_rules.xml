<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing the game stores (settings, saved game, test log) leaves the phone by backup or
     device transfer: testers share their log themselves (docs/poc/README.md, constraints). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
