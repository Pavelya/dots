    <!-- How to play (the wireframes' Rules) -->
    <string name="rules_title">How to play</string>
    <string name="rules_placing">Placing</string>
    <string name="rules_placing_text">Take turns placing a dot on a free point. Dots of one colour that touch, also diagonally, link up into chains.</string>
    <string name="rules_placing_picture">Three red dots linked into a chain, one link diagonal, and a blue dot.</string>
    <string name="rules_capturing">Capturing</string>
    <string name="rules_capturing_text">Close a ring of your dots around the other side’s dots to capture them. Each captured dot is a point for you, and the inside of the ring is out of play.</string>
    <string name="rules_capturing_picture">A red ring of four dots has captured a blue dot.</string>
    <string name="rules_empty">Empty rings</string>
    <string name="rules_empty_text">A ring around no dot of the other side captures nothing, and its inside stays open for play.</string>
    <string name="rules_empty_picture">A red ring of four dots around an empty point.</string>
    <string name="rules_border">The border</string>
    <string name="rules_border_text">Dots on the edge of the board can never be captured, because no ring can go round them.</string>
    <string name="rules_border_picture">A blue dot on the edge, with red dots around it, is safe.</string>
    <string name="rules_end">How a game ends</string>
    <string name="rules_end_text">Both sides have the same number of dots to place. When all are placed, whoever captured more dots wins.</string>
    <string name="rules_end_picture">Two red dots and two blue dots.</string>
