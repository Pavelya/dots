{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:refs/heads/main)",
      "Bash(git push --force)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git rev-parse *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list)",
      "Bash(gh issue list *)",
      "Bash(gh pr view)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(./gradlew --continue :engine:test :cli:test :cli:installDist :app:verifyRoborazziDebug :app:lintDebug :app:assembleDebug)",
      "Bash(./gradlew :engine:test *)",
      "Bash(./gradlew :engine:test)",
      "Bash(./gradlew :cli:test)",
      "Bash(./gradlew :cli:installDist)",
      "Bash(./gradlew :app:testDebugUnitTest *)",
      "Bash(./gradlew :app:testDebugUnitTest)",
      "Bash(./gradlew :app:verifyRoborazziDebug)",
      "Bash(./gradlew :app:recordRoborazziDebug)",
      "Bash(./gradlew :app:lintDebug)",
      "Bash(./gradlew :app:assembleDebug)",
      "Bash(cli/build/install/cli/bin/cli *)"
    ]
  }
}
